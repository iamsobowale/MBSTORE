# Copy this file to .env and fill in the values before running docker-compose.
# NEVER commit .env to version control.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 bytes, random. Generate: openssl rand -base64 32
JWT_KEY=change-me-minimum-32-chars-secret-key!!

# ── Admin seed account ────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=Change-Me-Strong-Pass1!

# ── Paystack ──────────────────────────────────────────────────────────────────
# Live keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# ── URLs ──────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
